# Copie para .env.local no desenvolvimento, sem incluir este arquivo real no Git.
# Configure os valores reais em Vercel > Settings > Environment Variables.

# Senha única, compartilhada apenas com responsáveis. Use uma senha aleatória com pelo menos 24 caracteres.
INTERCLASSE_SHARED_PASSWORD=COLE_AQUI_UMA_SENHA_FORTE_DE_PELO_MENOS_24_CARACTERES

# URL do projeto Supabase e chave service_role: somente funções server-side; nunca use prefixo VITE_.
SUPABASE_URL=https://dppbejaxouoqfnhutjmg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_CHAVE_SERVICE_ROLE_APENAS_NO_AMBIENTE_SERVER_SIDE
